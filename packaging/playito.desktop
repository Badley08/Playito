# SPDX-License-Identifier: GPL-3.0-or-later
[Desktop Entry]
Type=Application
Name=Playito
Comment=Lightweight Linux video and audio player
Exec=playito %F
Icon=playito
Terminal=false
Categories=AudioVideo;Player;Video;
MimeType=video/mp4;video/x-matroska;video/webm;video/x-msvideo;video/quicktime;video/x-flv;video/mpeg;video/mp2t;video/3gpp;video/x-ms-wmv;audio/mpeg;audio/flac;audio/x-flac;audio/ogg;audio/wav;audio/aac;audio/mp4;audio/opus;audio/x-ms-wma;
